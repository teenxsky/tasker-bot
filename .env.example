# App
APP_NAME=tasker-bot
APP_ENV=development
APP_DEBUG=1
APP_KEY=

APP_HOST=app
APP_INTERNAL_PORT=4000
APP_EXTERNAL_PORT=4000

APP_URL=http://0.0.0.0:4000
APP_TIMEZONE=Asia/Vladivostok

# Nginx
NGINX_INTERNAL_PORT=80
NGINX_EXTERNAL_PORT=8080

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres

DB_INTERNAL_PORT=5432
DB_EXTERNAL_PORT=5432

DB_DATABASE=tasker_bot
DB_USERNAME=root
DB_PASSWORD=root

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=stderr

# Cache
CACHE_STORE=database
